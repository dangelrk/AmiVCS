; $VER: Uninstall-AmiVCS 0.1 (27.09.2026)
; Uninstall-AmiVCS -- entfernt die von Install-AmiVCS installierten Dateien.
; SPDX-License-Identifier: GPL-3.0-or-later
; Copyright (C) 2026 Ronny Krueger
;
; Aufruf: Icon Uninstall-AmiVCS doppelt anklicken (IconX), oder in einer
; Shell:  Execute Uninstall-AmiVCS
;
; Löscht C:amivcs, C:amivcs-gui, SYS:Prefs/AmiVCSConfig (und das alte
; AMIVCSPrefs) und HELP:AmiVCS.guide. Die Einstellungen
; (ENV:/ENVARC:AmiVCS, alte amivcs.cfg) werden nur nach Rückfrage
; gelöscht. Repositories samt ihrer .amivcs/config bleiben unberührt.

FailAt 21

Echo ""
Echo "AmiVCS - Deinstallation"
Echo "======================="
Ask "AmiVCS wirklich deinstallieren? (y/n)"
If NOT WARN
  Echo "Abgebrochen, nichts gelöscht."
  Quit 0
EndIf

If EXISTS C:amivcs
  Delete C:amivcs QUIET
  Echo "  C:amivcs gelöscht."
EndIf
If EXISTS C:amivcs-gui
  Delete C:amivcs-gui QUIET
  Echo "  C:amivcs-gui gelöscht."
EndIf
If EXISTS SYS:Prefs/AmiVCSConfig
  Delete SYS:Prefs/AmiVCSConfig QUIET
  Echo "  SYS:Prefs/AmiVCSConfig gelöscht."
EndIf
If EXISTS SYS:Prefs/AmiVCSConfig.info
  Delete SYS:Prefs/AmiVCSConfig.info QUIET
EndIf
If EXISTS SYS:Prefs/AMIVCSPrefs
  Delete SYS:Prefs/AMIVCSPrefs QUIET
  Echo "  SYS:Prefs/AMIVCSPrefs gelöscht."
EndIf
If EXISTS SYS:Prefs/AMIVCSPrefs.info
  Delete SYS:Prefs/AMIVCSPrefs.info QUIET
EndIf

Assign >NIL: EXISTS HELP:
If NOT WARN
  If EXISTS HELP:AmiVCS.guide
    Delete HELP:AmiVCS.guide QUIET
    Echo "  HELP:AmiVCS.guide gelöscht."
  EndIf
  If EXISTS HELP:AmiVCS.guide.info
    Delete HELP:AmiVCS.guide.info QUIET
  EndIf
EndIf

Set unpref 0
If EXISTS ENVARC:AmiVCS
  Set unpref 1
EndIf
If EXISTS ENV:AmiVCS
  Set unpref 1
EndIf
If EXISTS ENVARC:amivcs.cfg
  Set unpref 1
EndIf
If EXISTS ENV:amivcs.cfg
  Set unpref 1
EndIf
If $unpref EQ 1
  Ask "Einstellungen (ENV:/ENVARC:AmiVCS, alte amivcs.cfg) auch löschen? (y/n)"
  If WARN
    If EXISTS ENVARC:AmiVCS
      Delete ENVARC:AmiVCS ALL QUIET
    EndIf
    If EXISTS ENV:AmiVCS
      Delete ENV:AmiVCS ALL QUIET
    EndIf
    If EXISTS ENVARC:amivcs.cfg
      Delete ENVARC:amivcs.cfg QUIET
    EndIf
    If EXISTS ENV:amivcs.cfg
      Delete ENV:amivcs.cfg QUIET
    EndIf
    Echo "  Einstellungen gelöscht."
  Else
    Echo "  Einstellungen bleiben erhalten."
  EndIf
EndIf
UnSet unpref

Echo ""
Echo "AmiVCS ist deinstalliert. Ihre Repositories (Verzeichnisse mit"
Echo "einem Unterverzeichnis .amivcs) sind unverändert."
Quit 0
